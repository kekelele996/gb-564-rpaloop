COMPOSE_PROJECT_NAME=rpaloop

# 宿主端口
FRONTEND_PORT=18237
BACKEND_PORT=19237
DB_PORT=17737

# MySQL 8.0
DB_NAME=rpaloop
DB_USER=rpaloop
